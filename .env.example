# ==========================================================================
# SvodkaPress NextGen — Environment Template
# Copy to `.env` and fill in real values. NEVER commit the resulting `.env`.
# ==========================================================================

# --------------------------------------------------------------------------
# Application runtime
# --------------------------------------------------------------------------
APP_NAME=SvodkaPress NextGen
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# --------------------------------------------------------------------------
# PostgreSQL 16 + pgvector
# --------------------------------------------------------------------------
POSTGRES_USER=svodkapress
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=svodkapress
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --------------------------------------------------------------------------
# Redis 7 (MinHash LSH index, ARQ queue, live log stream)
# Required: the container enables `--requirepass`, so the password must appear
# both here and inside REDIS_URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# --------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379/0
REDIS_MAXMEMORY=256mb
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_TIMEOUT=20

# --------------------------------------------------------------------------
# Host port publishing (dev only; bound to 127.0.0.1, never 0.0.0.0)
# Change these if another local project already owns the default ports.
# --------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
APP_HOST_PORT=8000

# --------------------------------------------------------------------------
# Security / Auth (JWT)
# --------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_me_generate_a_64_byte_url_safe_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------------------------
# Dashboard login
# --------------------------------------------------------------------------
# The dashboard has a single operator account. A bcrypt *hash* is stored rather
# than the password, so a leaked .env does not immediately yield a working login.
# Generate with: python -m app.core.security hash '<your password>'
#
# These two are the *bootstrap* values. Once the login or password is changed on
# /profile, the live credentials live in the `system_settings` table and take
# effect immediately; these are then only used when that row is absent.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_COOKIE_NAME=svodka_session

# Encrypts third-party API keys at rest. Deliberately separate from SECRET_KEY:
# rotating the JWT signing key should log everyone out, not make every stored
# API key permanently undecryptable.
# Generate with: python -m app.core.security genkey
FERNET_KEY=

# --------------------------------------------------------------------------
# AI / External API credentials
# --------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FAL_KEY=

# Telegram ingestion.
#
# Preferred path: real user accounts over MTProto, stored in the
# `telegram_accounts` table and rotated by the pool. Add one with:
#   python -m scripts.auth_telegram --phone +7... --api-id ... --api-hash ...
# The session string is encrypted with FERNET_KEY, so that key must be set
# before authorising an account, and rotating it invalidates every session.
# Credentials come from https://my.telegram.org/apps, per account.
#
# Fallback: the GramJS HTTP bridge, used only when no account is authorised.
# It cannot do 2FA sign-in or multi-account rotation.
GRAMJS_API_URL=http://gramjs:3000
GRAMJS_TOKEN=

# VK (posting + VK Video upload)
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199

# Odnoklassniki
OK_ACCESS_TOKEN=
OK_APPLICATION_KEY=
OK_SESSION_SECRET_KEY=
OK_GROUP_ID=

# Yandex Dzen
DZEN_TOKEN=
DZEN_CHANNEL_ID=

# Telegram publishing bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --------------------------------------------------------------------------
# WordPress target (REST API via Application Password)
# --------------------------------------------------------------------------
WP_BASE_URL=https://example.com
WP_APP_USER=
WP_APP_PASSWORD=

# --------------------------------------------------------------------------
# SSH credentials for remote site maintenance
# --------------------------------------------------------------------------
SSH_REMOTE_HOST=
SSH_REMOTE_USER=root
SSH_REMOTE_PORT=22
SSH_PRIVATE_KEY_PATH=/app/secrets/id_ed25519

# --------------------------------------------------------------------------
# AI default models
# --------------------------------------------------------------------------
AI_MODEL_ARBITER=openai/gpt-4o-mini
AI_MODEL_WRITER=anthropic/claude-3.5-sonnet
AI_MODEL_SEO=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=local/fastembed-minilm-l12-v2
AI_EMBEDDING_DIMENSIONS=384
AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=120

# --------------------------------------------------------------------------
# Deduplication thresholds
#   < LOWER              -> unique news event, new cluster
#   LOWER .. UPPER       -> ambiguous, escalate to AI arbiter
#   > UPPER              -> hard duplicate, skip
# --------------------------------------------------------------------------
SIMILARITY_LOWER_THRESHOLD=0.55
SIMILARITY_UPPER_THRESHOLD=0.76
MINHASH_NUM_PERM=128
DEDUP_LOOKBACK_HOURS=48

# --------------------------------------------------------------------------
# Playwright browser pool (memory safety: strict singleton)
# --------------------------------------------------------------------------
PLAYWRIGHT_MAX_CONCURRENT_PAGES=2
PLAYWRIGHT_NAVIGATION_TIMEOUT=45000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BLOCK_RESOURCES=true

# --------------------------------------------------------------------------
# Media processing
# --------------------------------------------------------------------------
MEDIA_STORAGE_PATH=/app/storage/media
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANGUAGES=rus+eng
OCR_WATERMARK_CONFIDENCE=60

# --------------------------------------------------------------------------
# Reverse proxy (Nginx Proxy Manager, Caddy, nginx, ...)
# --------------------------------------------------------------------------
# Hostnames this app answers to, comma-separated. Behind a proxy this is what
# stops Host-header injection: a forged `Host` is otherwise reflected into the
# post-login redirect, turning it into an open redirect.
#
# Production refuses to boot on all three unsafe forms, because each leaves the
# check switched off while still looking configured:
#   empty      -> the middleware is never registered at all
#   a `*` entry-> Starlette sets allow_any and stops checking (note that
#                 `127.0.0.1,*` also defeats a naive loopback check)
#   no loopback-> the container healthcheck and the deploy probe get a 400, so a
#                 correctly serving container is restarted
# `*.example.com` is fine; only a bare `*` is rejected.
ALLOWED_HOSTS=127.0.0.1,localhost

# Addresses whose `X-Forwarded-Proto` / `X-Forwarded-For` headers are honoured,
# so FastAPI knows the external request was HTTPS and logs the real client IP.
# Set this to the reverse proxy's address. `*` is refused in production: it would
# let any direct caller claim its plain-HTTP request was secure and forge client
# IPs. Docker bridge gateways are usually 172.16.0.0/12.
TRUSTED_PROXY_HOSTS=127.0.0.1

# Browser origins allowed to send cross-origin requests. Normally empty: the
# dashboard is server-rendered and same-origin, so it needs no CORS. Cookies mean
# credentialed requests, so `*` is invalid here and refused in production.
CORS_ALLOW_ORIGINS=

# --------------------------------------------------------------------------
# SEO analytics
# --------------------------------------------------------------------------
YANDEX_METRIKA_COUNTER_ID=
YANDEX_METRIKA_TOKEN=
GSC_CREDENTIALS_PATH=/app/secrets/gsc_service_account.json
GSC_SITE_URL=
